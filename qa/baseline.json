  "recorded_at_commit": "563b796",
  "note": "Fingerprint of the implementation the scenarios in run_scenarios.py were last reconciled with.",
  "implementation": {
    "risk_score_increments": [
      {
        "when": "context.get('duplicate_invoice_ids')",
        "add": "50"
      },
      {
        "when": "avg_amount > 0 AND multiplier >= settings.ANOMALY_MULTIPLIER",
        "add": "30"
      },
      {
        "when": "not context.get('vendor_found')",
        "add": "15"
      },
      {
        "when": "context.get('po_vendor_mismatch')",
        "add": "50"
      },
      {
        "when": "not (context.get('po_vendor_mismatch')) AND not validation.get('passed')",
        "add": "20 * len(validation.get('issues', []))"
      }
    ],
    "risk_level_rules": [
      {
        "when": "score >= 50",
        "level": "high"
      },
      {
        "when": "not (score >= 50) AND score >= 20",
        "level": "medium"
      },
      {
        "when": "not (score >= 50) AND not (score >= 20)",
        "level": "low"
      }
    ],
    "amount_tolerance_pct": 0.02,
    "anomaly_multiplier_default": "2.5",
    "status_assignments": [
      {
        "file": "app/agents/orchestrate_agent.py",
        "where": "OrchestrateAgent.run_pipeline",
        "target": "invoice.status",
        "value": "'pending_review'"
      },
      {
        "file": "app/agents/orchestrate_agent.py",
        "where": "OrchestrateAgent.apply_decision",
        "target": "invoice.status",
        "value": "decision"
      }
    ],
    "invoice_status_default": "pending_review",
    "routes": [
